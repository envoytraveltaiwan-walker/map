<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport"/>
  <meta content="#fcf8f3" name="theme-color"/>
  <meta content="跟著莉梅姐一起旅行：宜蘭樂水部落・泰雅文化深度一日遊。每週四出發、六人成團、台北專車接送。" name="description"/>
  <title>跟著莉梅姐一起旅行｜宜蘭樂水部落・泰雅文化深度一日遊</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Noto+Serif+TC:wght@500;600;700&display=swap" rel="stylesheet"/>

  <style>
    :root {
      --ink: #24352f;
      --soft: #526158;
      --rose: #b64f68;
      --roseLight: #fff0f2;
      --cream: #fcf8f3;
      --leaf: #456b5a;
      --border: #e6dfd5;
      --accent-gold: #C5A059;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--cream);
      color: var(--ink);
      font-family: 'Noto Sans TC', 'Noto Sans JP', sans-serif;
      font-size: 18px;
      line-height: 1.8;
      overflow-x: hidden;
    }
    button, a { font: inherit; }
    a { color: inherit; }
    a:focus-visible, button:focus-visible { outline: 3px solid #bd5470; outline-offset: 3px; }
    .container { width: min(1060px, calc(100% - 40px)); margin: auto; }

    /* ==================== 頂部導覽列 ==================== */
    .nav {
      background: rgba(252, 248, 243, 0.98);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(10px);
    }
    .navinner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 70px;
      gap: 10px;
    }

    .nav-brand-lockup {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      cursor: pointer;
      flex-shrink: 0;
    }
    .nav-emblem-img {
      height: 40px;
      width: auto;
      object-fit: contain;
      display: block;
    }
    .nav-brand-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      line-height: 1.2;
    }
    .nav-brand-en {
      font-family: 'Montserrat', sans-serif;
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 3px;
      color: var(--ink);
    }
    .nav-brand-zh {
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 1.5px;
      color: var(--accent-gold);
      margin-top: 2px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-back-home {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      background: white;
      border: 1px solid #c7c7c0;
      border-radius: 20px;
      padding: 6px 13px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      color: var(--ink);
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .btn-back-home:hover {
      background: var(--ink);
      color: white;
      border-color: var(--ink);
    }

    .lang-group {
      display: inline-flex;
      background: white;
      border: 1px solid #c7c7c0;
      border-radius: 20px;
      padding: 2px;
      gap: 2px;
    }
    .lang-group button {
      background: transparent;
      border: none;
      border-radius: 16px;
      padding: 5px 10px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      color: var(--soft);
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .lang-group button[aria-pressed=true] {
      background: var(--ink);
      color: white;
    }

    /* ==================== 頁面主體 ==================== */
    .hero {
      background: linear-gradient(120deg, #eef5f0, #fbf7f0 70%);
      padding: 44px 0 54px;
    }
    .hero .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) !important;
      max-width: 920px;
      margin-inline: auto;
      gap: 16px;
    }
    .eyebrow { font-size: 15.5px; color: var(--leaf); font-weight: 700; letter-spacing: .04em; }
    .hero h1 {
      font-family: 'Noto Serif TC', 'Noto Serif JP', serif;
      font-size: clamp(30px, 4.2vw, 48px);
      line-height: 1.35;
      letter-spacing: .015em;
      margin: 12px 0;
      white-space: normal;
    }
    .sub { font-size: 20px; font-weight: 700; color: var(--leaf); }
    .intro { max-width: 680px; margin: 18px 0 22px; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0; }
    .chip {
      border: 1px solid #c4d7cd;
      border-radius: 30px;
      padding: 4px 14px;
      font-weight: 600;
      font-size: 15.5px;
      background: #fff;
    }

    /* 價格卡片 */
    .price-section { margin-top: -18px; position: relative; }
    .price-card {
      background: #fff;
      border: 1px solid #d4e3da;
      box-shadow: 0 12px 30px rgba(36, 53, 47, 0.08);
      border-radius: 18px;
      padding: 26px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .price-card .label { color: var(--soft); font-size: 16px; }
    .amount { font-size: clamp(38px, 5vw, 54px); font-weight: 700; color: var(--leaf); line-height: 1.25; }
    .old { text-decoration: line-through; color: #757a74; }
    .small { font-size: 15.5px; color: var(--soft); }
    .save { color: var(--rose); font-weight: 700; font-size: 16px; }

    /* 各區塊樣式 */
    .section { padding: 60px 0; }
    .section.alt { background: #f3efe8; }
    h2 { font-family: 'Noto Serif TC', 'Noto Serif JP', serif; font-size: clamp(26px, 3vw, 34px); line-height: 1.4; margin: 0 0 22px; }
    h3 { font-size: 21px; line-height: 1.5; margin: 0 0 8px; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .tile { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
    .num { font-size: 28px; margin-bottom: 12px; }
    .story { max-width: 850px; font-size: 18.5px; }

    /* 體驗內容結構卡片 (無具體時間點，無車型承諾) */
    .departure-badge-box {
      background: #eef7f2;
      border-left: 4px solid var(--leaf);
      border-radius: 8px;
      padding: 14px 20px;
      margin-bottom: 24px;
      font-size: 16.5px;
      color: var(--ink);
      font-weight: 600;
    }
    .departure-badge-box span { color: var(--leaf); font-weight: 800; margin-right: 6px; }

    .experience-list-wrap {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .experience-card-item {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px 26px;
      display: flex;
      align-items: flex-start;
      gap: 20px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .experience-card-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(36, 53, 47, 0.07);
    }
    .exp-icon-box {
      width: 48px;
      height: 48px;
      background: #f4faf6;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
      border: 1px solid #d4e8dd;
    }
    .exp-body h4 {
      font-size: 19px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .exp-body h4 .tag-mini {
      font-size: 12.5px;
      color: var(--leaf);
      background: #eef7f2;
      padding: 2px 8px;
      border-radius: 6px;
      font-weight: 600;
    }
    .exp-body p {
      font-size: 16px;
      color: var(--soft);
      line-height: 1.6;
    }

    /* 莉梅姐介紹 */
    .hostbox {
      display: flex;
      align-items: center;
      gap: 24px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
    }
    .hostbox img {
      width: 120px;
      height: 120px;
      object-fit: cover;
      border-radius: 50%;
      flex-shrink: 0;
      border: 2px solid #d4e3da;
    }

    /* 報名三步驟卡片 */
    .steps-container {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 10px;
    }
    .step-box-card {
      background: #ffffff;
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .step-box-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(36, 53, 47, 0.08);
    }
    .step-badge-pill {
      background: var(--ink);
      color: #fff;
      font-size: 14px;
      font-weight: 800;
      padding: 6px 14px;
      border-radius: 20px;
      flex-shrink: 0;
      letter-spacing: 0.5px;
    }
    .step-badge-pill.gold { background: #d97706; }
    .step-badge-pill.leaf { background: var(--leaf); }

    .step-body-content h4 {
      font-size: 18.5px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .step-body-content p {
      font-size: 16px;
      color: var(--soft);
      line-height: 1.55;
    }

    /* 結尾純淨段落 */
    .final-clean-wrap {
      background: #eaf0e9;
      text-align: center;
      padding: 60px 0 50px;
    }
    .final-clean-wrap h2 { margin-bottom: 14px; }
    .final-clean-wrap p {
      margin: 0 auto;
      max-width: 680px;
      font-size: 17.5px;
      line-height: 1.7;
      color: var(--soft);
    }

    /* ==================== 頁尾 (與首頁 100% 相同深色規格) ==================== */
    .et-footer {
      background: #051218;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 36px 40px 110px;
      color: #94A3B8;
      font-size: 13px;
      line-height: 1.6;
    }
    .footer-wrapper { max-width: 1060px; margin: 0 auto; }
    .footer-company-full {
      font-size: 13.5px;
      font-weight: 800;
      color: #CBD5E1;
      margin-bottom: 10px;
    }

    .footer-legal-small {
      font-size: 11px;
      color: #64748B;
      line-height: 1.7;
      margin-bottom: 14px;
    }
    .footer-legal-small span { margin-right: 14px; display: inline-block; }

    .footer-links-bar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding: 12px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 12px;
    }
    .footer-link-a { color: #38BDF8; text-decoration: none; font-weight: 700; font-size: 13px; }
    .footer-link-a:hover { color: #FFF; }
    .footer-link-a.line-channel { color: #4ADE80; font-weight: 900; }
    .footer-divider { color: #334155; }

    .footer-cc-source {
      font-size: 11px;
      color: #64748B;
      margin-bottom: 6px;
      line-height: 1.6;
    }
    .footer-cc-source a { color: #94A3B8; text-decoration: underline; }
    .footer-copyright { font-size: 11.5px; color: #64748B; }

    /* 底部唯一吸附按鈕 */
    .sticky {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 200;
      background: rgba(255, 254, 252, 0.96);
      box-shadow: 0 -4px 20px rgba(36, 53, 47, 0.15);
      padding: 10px max(20px, env(safe-area-inset-left)) calc(10px + env(safe-area-inset-bottom));
      display: flex;
      justify-content: center;
      backdrop-filter: blur(8px);
    }
    .sticky .button {
      width: min(100%, 500px);
      min-height: 52px;
      background: #06a54e;
      color: #fff;
      border-radius: 12px;
      font-size: 18.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    @media (max-width: 750px) {
      body { font-size: 17px; }
      .container { width: calc(100% - 30px); }
      .navinner { min-height: 64px; }
      .nav-emblem-img { height: 34px; }
      .nav-brand-en { font-size: 15px; letter-spacing: 2px; }
      .nav-brand-zh { font-size: 9px; letter-spacing: 1px; }
      .btn-back-home { padding: 5px 10px; font-size: 13px; }
      .lang-group button { padding: 4px 8px; font-size: 12px; }

      .hero { padding: 26px 0 38px; }
      .price-card { flex-direction: column; align-items: flex-start; padding: 20px; }
      .section { padding: 44px 0; }
      .grid { grid-template-columns: 1fr; }
      
      .experience-card-item {
        flex-direction: column;
        gap: 12px;
        padding: 18px 20px;
      }
      .hostbox { flex-direction: column; align-items: flex-start; }
      .hostbox img { width: 100px; height: 100px; }

      .step-box-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 16px 18px;
      }
      .et-footer { padding: 30px 20px 100px; }
    }

    @media (max-width: 375px) {
      .nav-brand-zh { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>
