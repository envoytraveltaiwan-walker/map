  <!-- 動態腳本 -->
  <script>
    const railPath = document.getElementById('rail-path');
    const engineLead = document.getElementById('engine-lead');
    const car1 = document.getElementById('car-1');
    const car2 = document.getElementById('car-2');
    const car3 = document.getElementById('car-3');

    const totalRailLen = railPath.getTotalLength();
    let trainDist = 0;
    const trainSpeed = 1.35;
    const DIST_CAR1 = 28, DIST_CAR2 = 24, DIST_CAR3 = 24;

    function calcPathPointAndAngle(d) {
      let dist = d % totalRailLen;
      if (dist < 0) dist += totalRailLen;
      const pt = railPath.getPointAtLength(dist);
      const nextPt = railPath.getPointAtLength((dist + 1.2) % totalRailLen);
      const angle = Math.atan2(nextPt.y - pt.y, nextPt.x - pt.x) * 180 / Math.PI;
      return { x: pt.x, y: pt.y, angle: angle };
    }

    function updateTrainMovement() {
      trainDist += trainSpeed;
      const pEngine = calcPathPointAndAngle(trainDist);
      engineLead.setAttribute('transform', `translate(${pEngine.x}, ${pEngine.y}) rotate(${pEngine.angle})`);
      const pCar1 = calcPathPointAndAngle(trainDist - DIST_CAR1);
      car1.setAttribute('transform', `translate(${pCar1.x}, ${pCar1.y}) rotate(${pCar1.angle})`);
      const pCar2 = calcPathPointAndAngle(trainDist - DIST_CAR1 - DIST_CAR2);
      car2.setAttribute('transform', `translate(${pCar2.x}, ${pCar2.y}) rotate(${pCar2.angle})`);
      const pCar3 = calcPathPointAndAngle(trainDist - DIST_CAR1 - DIST_CAR2 - DIST_CAR3);
      car3.setAttribute('transform', `translate(${pCar3.x}, ${pCar3.y}) rotate(${pCar3.angle})`);
    }

    const canvas = document.getElementById('fx-canvas');
    const ctx = canvas.getContext('2d');
    const mapStage = document.getElementById('map-stage');
    const liveText = document.getElementById('live-weather-text');

    let currentMode = 'bailan';
    let drops = [];
    const DROP_COUNT = 55;

    const weatherConfig = {
      bailan:   { text: '蒸氣火車巡禮中 ‧ 新竹白蘭櫻花雨' },
      swasiq:   { text: '蒸氣火車巡禮中 ‧ 苗栗斯瓦細格溫泉山林與龍葵綠意' },
      leshui:   { text: '蒸氣火車巡禮中 ‧ 宜蘭樂水青竹葉雨' },
      pratan:   { text: '蒸氣火車巡禮中 ‧ 花蓮布拉旦彩虹靈光' },
      ceroh:    { text: '蒸氣火車巡禮中 ‧ 花蓮織羅彩繪米雨' },
      yongkang: { text: '蒸氣火車巡禮中 ‧ 台東永康星空星芒雨' },
      saza:     { text: '蒸氣火車巡禮中 ‧ 台東鸞山巨木雨' },
      rinari:   { text: '蒸氣火車巡禮中 ‧ 屏東禮納里純白百合雨' },
      ulaljuc:  { text: '蒸氣火車巡禮中 ‧ 屏東吾拉魯滋咖啡豆雨' }
    };

    function resizeCanvas() {
      if (mapStage) {
        canvas.width = mapStage.clientWidth;
        canvas.height = mapStage.clientHeight;
      }
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    class DropItem {
      constructor(init = false) { this.reset(init); }
      reset(init = false) {
        this.x = Math.random() * canvas.width;
        this.y = init ? Math.random() * canvas.height : -20 - Math.random() * 40;
        this.type = currentMode;
        this.rot = Math.random() * Math.PI * 2;
        this.rotSpeed = (Math.random() - 0.5) * 0.04;
        this.alpha = Math.random() * 0.4 + 0.6;

        switch(this.type) {
          case 'bailan':
            this.vx = Math.sin(Math.random() * Math.PI) * 1.5 + 0.5;
            this.vy = Math.random() * 2 + 1.8;
            this.size = Math.random() * 12 + 9;
            this.color = Math.random() > 0.3 ? '#FFA3B8' : '#FF85A1';
            break;
          case 'swasiq':
            this.vx = (Math.random() - 0.5) * 1.6;
            this.vy = Math.random() * 2 + 1.5;
            this.size = Math.random() * 12 + 8;
            this.color = Math.random() > 0.5 ? '#52B788' : '#D8F3DC';
            break;
          case 'leshui':
            this.vx = (Math.random() - 0.5) * 1.8;
            this.vy = Math.random() * 2.2 + 2;
            this.size = Math.random() * 14 + 10;
            this.color = Math.random() > 0.5 ? '#588157' : '#8DAA72';
            break;
          case 'pratan':
            const r = ['#E63946', '#FFD166', '#06D6A0', '#118AB2', '#9D4EDD'];
            this.vx = (Math.random() - 0.5) * 1.2;
            this.vy = Math.random() * 2.5 + 2.5;
            this.size = Math.random() * 8 + 6;
            this.color = r[Math.floor(Math.random() * r.length)];
            break;
          case 'ceroh':
            const rc = ['#D62828', '#F4A261', '#FAF0CA', '#2A9D8F'];
            this.vx = (Math.random() - 0.5) * 1;
            this.vy = Math.random() * 3 + 2.8;
            this.size = Math.random() * 8 + 5;
            this.color = rc[Math.floor(Math.random() * rc.length)];
            break;
          case 'yongkang':
            this.vx = (Math.random() - 0.5) * 1.5;
            this.vy = Math.random() * 2 + 1.5;
            this.size = Math.random() * 7 + 4;
            this.color = '#FFD166';
            break;
          case 'saza':
            this.vx = Math.cos(Math.random() * Math.PI) * 2;
            this.vy = Math.random() * 2.5 + 2;
            this.size = Math.random() * 15 + 10;
            this.color = '#2D6A4F';
            break;
          case 'rinari':
            this.vx = (Math.random() - 0.5) * 1.6;
            this.vy = Math.random() * 2 + 1.8;
            this.size = Math.random() * 13 + 8;
            this.color = '#FFFFFF';
            break;
          case 'ulaljuc':
          default:
            this.vx = (Math.random() - 0.5) * 1.4;
            this.vy = Math.random() * 2.8 + 2.2;
            this.size = Math.random() * 11 + 7;
            this.color = '#3D1E06';
            break;
        }
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.rot += this.rotSpeed;
        if (this.y > canvas.height + 25 || this.x < -30 || this.x > canvas.width + 30) {
          this.reset(false);
        }
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rot);
        ctx.globalAlpha = this.alpha;
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(0, 0, this.size * 0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    for (let i = 0; i < DROP_COUNT; i++) drops.push(new DropItem(true));

    function switchWeather(type) {
      if (currentMode === type) return;
      currentMode = type;
      if (weatherConfig[type] && liveText) liveText.innerText = weatherConfig[type].text;
      drops.forEach((d, idx) => {
        if (idx % 2 === 0) d.reset(false);
        else d.type = currentMode;
      });
    }

    function renderLoop() {
      updateTrainMovement();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < drops.length; i++) {
        drops[i].update();
        drops[i].draw();
      }
      requestAnimationFrame(renderLoop);
    }
    renderLoop();
  </script>
