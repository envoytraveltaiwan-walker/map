    #map-svg { width: 100%; height: 100%; object-fit: contain; }
    #fx-canvas {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 500;
    }
    .map-live-tag {
      position: absolute;
      top: 20px; right: 24px;
      background: rgba(13, 43, 56, 0.92);
      backdrop-filter: blur(10px);
      border: 1.5px solid rgba(255, 255, 255, 0.35);
      border-radius: 22px;
      padding: 8px 18px;
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 800;
      z-index: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .status-pulse {
      width: 10px; height: 10px;
      background: var(--line-green);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--line-green);
      animation: pulse-dot 1.2s infinite ease-in-out;
    }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.3); } }
    .interactive-card { cursor: pointer; transition: transform 0.15s ease; }
    .interactive-card:active { transform: scale(0.97); }

    /* 蒸汽白煙動畫 */
    @keyframes puff-smoke {
      0% { r: 4px; opacity: 0.95; transform: translateY(0) scale(0.8); }
      40% { r: 12px; opacity: 0.8; transform: translateY(-10px) translateX(-6px) scale(1.3); }
      100% { r: 22px; opacity: 0; transform: translateY(-24px) translateX(-16px) scale(2); }
    }
    .smoke-puff-1 { animation: puff-smoke 1.3s infinite ease-out; }
    .smoke-puff-2 { animation: puff-smoke 1.3s infinite ease-out 0.26s; }
    .smoke-puff-3 { animation: puff-smoke 1.3s infinite ease-out 0.52s; }

