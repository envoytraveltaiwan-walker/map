      font-weight: 700;
      margin-bottom: 8px;
    }
    .map-header-desc {
      font-size: 15px;
      color: var(--text-muted);
    }

    .map-frame-wrapper {
      position: relative;
      width: 100%;
      height: 750px;
      background: #BCE3EC;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0,0,0,0.5);
      margin-bottom: 50px;
