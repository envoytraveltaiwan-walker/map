<!-- 編輯工具 -->
<div class="editor">
  <button class="primary" id="toggle">
    開啟編輯模式
  </button>

  <button class="secondary" id="save">
    儲存本機修改
  </button>

  <button class="secondary" id="download">
    下載修改後 HTML
  </button>

  <button class="secondary" id="print">
    列印／存 PDF
  </button>

  <span class="status" id="status">
    內容可直接編輯
  </span>
</div>

<script>
const editable = [
  ...document.querySelectorAll("[data-edit]")
];

const storageKey = "envoy-bailan-2027-final-v4";

function snapshot() {
  return editable.map(el => el.innerHTML);
}

try {
  const saved = JSON.parse(
    localStorage.getItem(storageKey) || "null"
  );

  if (saved && saved.length === editable.length) {
    editable.forEach((el, i) => {
      el.innerHTML = saved[i];
    });
  }
} catch (error) {
  console.warn("無法載入已儲存內容", error);
}

let editing = false;

document.getElementById("toggle").onclick = () => {
  editing = !editing;

  document.body.classList.toggle(
    "editmode",
    editing
  );

  editable.forEach(el => {
    el.contentEditable = editing ? "true" : "false";
  });

  document.getElementById("toggle").textContent =
    editing ? "完成編輯" : "開啟編輯模式";

  document.getElementById("status").textContent =
    editing
      ? "點擊虛線區塊即可修改"
      : "內容可直接編輯";
};

document.getElementById("save").onclick = () => {
  try {
    localStorage.setItem(
      storageKey,
      JSON.stringify(snapshot())
    );

    document.getElementById("status").textContent =
      "已儲存於此瀏覽器";
  } catch (error) {
    alert("無法儲存，請改用下載 HTML");
  }
};

document.getElementById("download").onclick = () => {
  editable.forEach(el => {
    el.contentEditable = "false";
  });

  document.body.classList.remove("editmode");
  editing = false;

  document.getElementById("toggle").textContent =
    "開啟編輯模式";

  const html =
    "<!DOCTYPE html>\n" +
    document.documentElement.outerHTML;

  const blob = new Blob(
    [html],
    { type:"text/html;charset=utf-8" }
  );

  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download =
    "ENVOY_Bailan_2027_Itinerary.html";

  link.click();

  setTimeout(() => {
    URL.revokeObjectURL(url);
  }, 2000);
};

document.getElementById("print").onclick = () => {
  window.print();
};
</script>

